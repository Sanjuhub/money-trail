DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_trail
SESSION_SECRET=replace-this-with-at-least-32-random-characters
# SESSION_SECRET is used to derive separate access-token and refresh-token signing keys.
# Optional: protect /api/cron/daily with this bearer secret and call it once a day.
CRON_SECRET=replace-this-with-a-long-random-secret
# Optional private receipt object-store HTTP gateway. Without it, receipts are stored locally under .data/receipts.
RECEIPT_STORAGE_URL=
RECEIPT_STORAGE_TOKEN=
